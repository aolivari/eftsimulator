# Copiar a .env.local para desarrollo (npm run dev) y añadir las mismas en Vercel.

# ─── Navegador (públicas, con prefijo VITE_) ───
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Publishable key (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=sb_publishable_...
# Botón "Continuar con Google": solo tras activar el proveedor Google en Supabase
VITE_AUTH_GOOGLE=false

# ─── Servidor (NO usar prefijo VITE_) ───
# Ingesta de noticias (/api/news/ingest)
TAVILY_API_KEY=tvly-...
# Secreto del endpoint; Vercel Cron lo envía como "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Opcionales: días recientes (3), tope de consultas por ejecución (12), dominios permitidos (lista por comas)
# NEWS_DAYS=3
# NEWS_MAX_QUERIES=12
# NEWS_ALLOWED_DOMAINS=reuters.com,ft.com
