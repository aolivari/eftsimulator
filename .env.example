# Copiar a .env.local para desarrollo (npm run dev) y añadir las mismas en Vercel.

# ─── Navegador (públicas, con prefijo VITE_; el servidor también las lee) ───
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Publishable key (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=sb_publishable_...
# Botón "Continuar con Google": solo tras activar el proveedor Google en Supabase
VITE_AUTH_GOOGLE=false

# ─── Solo servidor (/api/*) · NUNCA con prefijo VITE_ ───
# Secret key (sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
KRONOS_SERVICE_URL=https://kronos-xxxxxxxx-ew.a.run.app
KRONOS_API_KEY=una-clave-larga-aleatoria
# Clave JSON (en base64) de la cuenta de servicio con rol run.invoker sobre el servicio kronos
GCP_SERVICE_ACCOUNT_KEY=ewogICJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIs...
# Opcional: cálculos nuevos de Kronos por usuario y día (por defecto 25)
KRONOS_DAILY_LIMIT_PER_USER=25
